PORT=4000
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/bse_trades
PULL_DURATION_MS=900000
API_KEY=your-secret-api-key
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
NODE_ENV=development
TRUST_PROXY=1
# In production (NODE_ENV=production) both MONGO_URI and API_KEY are REQUIRED;
# the server fails fast on boot if either is missing.
