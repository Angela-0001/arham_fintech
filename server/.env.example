PORT=4000

# MySQL connection — use URI OR individual vars (not both)
MYSQL_URI=mysql://user:password@localhost:3306/bse_trades
# OR:
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=secret
# MYSQL_DATABASE=bse_trades

PULL_DURATION_MS=900000
API_KEY=your-secret-api-key
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
NODE_ENV=development
TRUST_PROXY=1

# In production (NODE_ENV=production) MySQL config and API_KEY are REQUIRED;
# the server fails fast on boot if either is missing.
